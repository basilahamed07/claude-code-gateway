# ==============================================================================
# Universal Claude Code LLM Gateway - Environment Variables Template
# Copy this file to .env and configure your desired provider.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gateway Settings (Required for all providers)
# ------------------------------------------------------------------------------
# Local gateway listening port (default: 4000)
GATEWAY_PORT=4000

# Secret key between Claude Code and the local proxy (minimum 32 characters)
# Generate one: python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
GATEWAY_MASTER_KEY=sk-replace-with-a-random-32-char-secret-key-12345

# The model alias that Claude Code will request (e.g. custom-model, gemma-4-31B-it, claude-3-5-sonnet)
GATEWAY_MODEL_ALIAS=custom-model

# ------------------------------------------------------------------------------
# 2. Provider: Custom Endpoint / Internal vLLM / Open WebUI / LM Studio
CUSTOM_API_BASE=http://your-server-ip:8080/api
CUSTOM_API_KEY=your_upstream_api_key_here
CUSTOM_MODEL_ID=google/gemma-4-31b-it

# ------------------------------------------------------------------------------
# 3. Provider: Azure OpenAI / Azure AI Foundry
# ------------------------------------------------------------------------------
# AZURE_API_BASE=https://your-resource-name.openai.azure.com/
# AZURE_API_KEY=your_azure_api_key
# AZURE_API_VERSION=2024-08-01-preview
# AZURE_DEPLOYMENT_NAME=gpt-4o

# ------------------------------------------------------------------------------
# 4. Provider: AWS Bedrock
# ------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION_NAME=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ------------------------------------------------------------------------------
# 5. Provider: Google Gemini / Vertex AI
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL_ID=gemini-2.5-pro

# ------------------------------------------------------------------------------
# 6. Provider: Ollama (Local)
# ------------------------------------------------------------------------------
# OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_MODEL_ID=qwen2.5-coder:32b

# ------------------------------------------------------------------------------
# 7. Provider: OpenAI Direct
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL_ID=gpt-4o

# ------------------------------------------------------------------------------
# 8. Provider: Groq / DeepSeek / Mistral / OpenRouter
# ------------------------------------------------------------------------------
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
